# --- SQLite database artifacts -------------------------------------------
# Local databases and their sidecar files. Never commit a database file.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# --- Local database secrets -----------------------------------------------
# Never commit the local database credentials.
db/postgres/.env

# --- Build and tool output ------------------------------------------------
node_modules/
dist/
build/
target/
*.pyc
__pycache__/
.venv/
venv/

# --- Go build and coverage artifacts ---------------------------------------
# Binaries written by `make build` and the coverage files written by
# `make cover`. Never commit them.
bin/
coverage.out
.coverage/

# --- Editor and OS noise --------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
