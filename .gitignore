# --- SQLite database artifacts -------------------------------------------
# Local databases and their sidecar files. Never commit a database file.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# --- The secrets of the installation ---------------------------------------
# Never commit the local credentials. The `.env` files are generated by the
# installer of the environment (`make env-init`) and hold the secrets of the
# stacks: the database password, and whatever a stack adds later. The rule
# covers every stack of the monorepository, at any depth.
.env
# The temporary file of the atomic write of the installer. It holds the
# secrets of the stack while it is written, and it must never be committed.
.env.tmp.*

# --- Build and tool output ------------------------------------------------
node_modules/
dist/
build/
target/
*.pyc
__pycache__/
.venv/
venv/

# --- Go build and coverage artifacts ---------------------------------------
# Binaries written by `make build` and the coverage files written by
# `make cover`. Never commit them.
bin/
coverage.out
.coverage/

# --- Editor and OS noise --------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
