# The build context of the image of the database admin service.
#
# The context is the directory of the project, and the image only needs the
# module of the service. Everything else is noise for the build.

# The build artifacts.
bin/
.coverage/
coverage.out

# The tests of the stack: they run in their own container, not in the image.
test/

# The version control and the editor noise.
.git/
.gitignore
.idea/
.vscode/
*.swp
.DS_Store

# The documentation and the development files.
README.md
Makefile
docker-compose*.yml
