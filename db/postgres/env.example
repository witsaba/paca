# The credentials of the PostgreSQL stack.
#
# This file is the manifest of the stack: the installer of the environment
# reads it, offers every value with its default and writes the `.env` next
# to it. The manual fallback still works:
#
#   cp db/postgres/env.example db/postgres/.env
#
# The metadata of the manifest lives in the comments of the file, so it
# stays a valid Compose `env_file` and there is no second file to keep in
# sync. The directives of a key are:
#
#   # @secret     the value is a secret: it is never printed and the file
#                that holds it is written with the mode 600
#   # @generate   a strong value can be generated for the key
#
# Any other comment line directly above a key is its description: the text
# the person who installs reads.

# The owner role and the superuser of the application database.
POSTGRES_USER=paca

# The application database of the stack.
POSTGRES_DB=paca

# The password of the role. It is a secret: the installer generates a strong
# one and never prints it.
# @secret
# @generate
POSTGRES_PASSWORD=change-me-generate-a-strong-password
