# The version of the images of the monorepository.
#
# This file is the manifest of the root: the installer of the environment
# reads it and writes the `.env` next to it. The manual fallback still
# works:
#
#   cp env.example .env
#
# The compose files interpolate the version into the tags of the images they
# build, so a release is installed by changing this one value.

# The tag of the images of the monorepository.
PACA_VERSION=dev
